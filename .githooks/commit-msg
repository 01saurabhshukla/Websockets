#!/bin/bash

# ============================================================
# COMMIT-MSG HOOK
# Validates that commit messages follow Conventional Commits format.
#
# Valid formats:
#   feat: add room broadcasting
#   fix: resolve opcode preservation bug
#   refactor: extract WebSocketReceiver into own module
#   test: add unit tests for RoomManager
#   docs: update CHANGELOG with latest changes
#   chore: update package.json scripts
#   style: fix CSS typo in styles.css
#
# Optional scope:
#   feat(rooms): add join/leave support
#   fix(receiver): handle fragmented frames
#
# Breaking changes (add ! before colon):
#   feat!: redesign message protocol
#   refactor(api)!: change handler interface
# ============================================================

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Allow merge commits (auto-generated by git)
if echo "$COMMIT_MSG" | grep -qE "^Merge "; then
    exit 0
fi

# Conventional Commits pattern:
# type(optional-scope)optional-!: description
PATTERN="^(feat|fix|refactor|test|docs|chore|style|perf|ci|build|revert)(\([a-z0-9 -]+\))?\!?: .{1,}"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo ""
    echo "❌ COMMIT BLOCKED: Invalid commit message format!"
    echo ""
    echo "   Your message:  \"$COMMIT_MSG\""
    echo ""
    echo "   Expected format: <type>: <description>"
    echo ""
    echo "   Valid types:"
    echo "     feat:     New feature"
    echo "     fix:      Bug fix"
    echo "     refactor: Code restructuring (no new features, no bug fixes)"
    echo "     test:     Adding or updating tests"
    echo "     docs:     Documentation changes"
    echo "     chore:    Build, config, tooling changes"
    echo "     style:    Code style / formatting (no logic change)"
    echo "     perf:     Performance improvement"
    echo "     ci:       CI/CD changes"
    echo "     build:    Build system changes"
    echo "     revert:   Reverting a previous commit"
    echo ""
    echo "   Examples:"
    echo "     feat: add room broadcasting support"
    echo "     fix: resolve opcode preservation bug"
    echo "     refactor(receiver): extract state machine into own module"
    echo "     test: add integration tests for RoomManager"
    echo ""
    echo "   To skip this check (NOT recommended): git commit --no-verify"
    echo ""
    exit 1
fi

# Check description length (max 350 chars for the first line — Git best practice)
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n 1)
if [ ${#FIRST_LINE} -gt 350 ]; then
    echo ""
    echo "⚠️  COMMIT BLOCKED: First line is too long (${#FIRST_LINE} chars, max 350)."
    echo "   Keep the first line concise. Add details in the commit body."
    echo ""
    echo "   Example:"
    echo "     feat: add room broadcasting     ← first line (short)"
    echo "                                      ← blank line"
    echo "     Added RoomManager, ConnectionRegistry, and MessageRouter."
    echo "     Rooms support join, leave, broadcast, and list operations."
    echo ""
    exit 1
fi

echo "✅ Commit message format is valid."
exit 0
